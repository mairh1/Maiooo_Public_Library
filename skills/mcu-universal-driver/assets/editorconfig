# 单片机嵌入式 C 代码编辑器配置模板（mcu-universal-driver skill）
# end_of_line = lf 与项目 .gitattributes 保持一致
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{S,s}]
indent_style = space
indent_size = 4

[*.ld]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
